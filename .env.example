# ─────────────────────────────────────────────────────────────────
# Terminus configuration — copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────────

# LLM Provider (Groq, OpenCode Go, Ollama, or any OpenAI-compatible endpoint)
TERMINUS_LLM_BASE_URL=https://api.groq.com/openai/v1
TERMINUS_LLM_API_KEY=
TERMINUS_LLM_MODEL=openai/gpt-oss-20b

# Named model connections: independent 32-byte base64url encryption key.
# Required only to save/rotate API credentials; never stored in SQLite or generated automatically.
# Generate once: uv run python -c "from terminus.model_gateway.secrets import CredentialCipher; print(CredentialCipher.generate_key().get_secret_value())"
# Keep in a protected environment/secret service; back up separately from the database.
TERMINUS_MODEL_CREDENTIALS_KEY=

# Wazuh SIEM
TERMINUS_WAZUH_URL=
TERMINUS_WAZUH_USER=
TERMINUS_WAZUH_PASSWORD=

# Notifications — SMS
TERMINUS_SMS_TO=
TERMINUS_TWILIO_SID=
TERMINUS_TWILIO_TOKEN=
TERMINUS_TWILIO_FROM=

# Notifications — Slack
TERMINUS_SLACK_WEBHOOK=

# Ticketing — Jira
TERMINUS_JIRA_URL=
TERMINUS_JIRA_USER=
TERMINUS_JIRA_TOKEN=
TERMINUS_JIRA_PROJECT=

# Secrets — auto-generated if empty (fine for dev; set for production)
TERMINUS_LICENSE_SECRET=
TERMINUS_TOKEN_SECRET=

# Identity deployment: local keeps the demo login; hosted never creates it.
# Hosted mode requires a stable LICENSE_SECRET and HTTPS (secure cookies).
TERMINUS_DEPLOYMENT_MODE=local
# Optional first-run owner credentials; configure both together (password >=12 chars).
# Existing users/passwords/memberships are never reset by bootstrap.
TERMINUS_BOOTSTRAP_ADMIN_EMAIL=
TERMINUS_BOOTSTRAP_ADMIN_PASSWORD=
