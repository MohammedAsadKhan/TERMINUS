# ─────────────────────────────────────────────────────────────────
# agentsoc configuration — copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────────

# LLM Provider (Groq, OpenCode Go, Ollama, or any OpenAI-compatible endpoint)
AGENTSOC_LLM_BASE_URL=https://api.groq.com/openai/v1
AGENTSOC_LLM_API_KEY=
AGENTSOC_LLM_MODEL=llama-3.3-70b-versatile

# Wazuh SIEM
AGENTSOC_WAZUH_URL=
AGENTSOC_WAZUH_USER=
AGENTSOC_WAZUH_PASSWORD=

# Notifications — SMS
AGENTSOC_SMS_TO=9364992155
AGENTSOC_TWILIO_SID=
AGENTSOC_TWILIO_TOKEN=
AGENTSOC_TWILIO_FROM=

# Notifications — Slack
AGENTSOC_SLACK_WEBHOOK=

# Ticketing — Jira
AGENTSOC_JIRA_URL=
AGENTSOC_JIRA_USER=
AGENTSOC_JIRA_TOKEN=
AGENTSOC_JIRA_PROJECT=

# Secrets — auto-generated if empty (fine for dev; set for production)
AGENTSOC_LICENSE_SECRET=
AGENTSOC_TOKEN_SECRET=
